
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Blog Post</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>
<body>

    <header>
        <h1>Edit Blog Post</h1>
        <p>Edit your blog post below.</p>
    </header>

    <main>
        <section>
            <h2>Edit Your Post</h2>

            <p>
                <strong>Author:</strong>
                <%= post.author %>
            </p>

            <form
                action="/posts/<%= post.id %>/edit"
                method="POST"
            >

                <label for="title">Blog Title:</label>
                <input
                    type="text"
                    id="title"
                    name="title"
                    value="<%= post.title %>"
                    maxlength="255"
                    required
                >

                <label for="content">Blog Content:</label>
                <textarea
                    id="content"
                    name="content"
                    rows="8"
                    required
                ><%= post.content %></textarea>

                <button type="submit">
                    Save Changes
                </button>

            </form>

            <p>
                <a href="/">Cancel and Return Home</a>
            </p>
        </section>
    </main>

</body>
</html>
